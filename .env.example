# Copy this file to .env and replace the placeholders with your Neon values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SESSION_IDLE_TIMEOUT_SECONDS=300
DATABASE_URL=postgresql://USER:PASSWORD@HOST/NEON_DATABASE?sslmode=require

# User-uploaded files (profile photos and learning resources). Production
# requires a private Neon Object Storage bucket (or another private S3 bucket).
# For local-only disposable development, set DJANGO_DEBUG=true and
# USE_REMOTE_MEDIA=false (otherwise local uploads go to your disk).
USE_REMOTE_MEDIA=true
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Neon Object Storage uses path-style addressing. Use `auto` for AWS S3 if needed.
AWS_S3_ADDRESSING_STYLE=path

# Optional SMTP settings for password reset emails in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Velocity Tech University <no-reply@example.com>
